# Environment Configuration Template
# Copy this file to .env and fill in your actual values

# General Configuration
ENVIRONMENT=development
API_BASE_URL=http://0.0.0.0:8000

# Ollama API Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DECISION_MODEL=tev1:4b
OLLAMA_GENERATIVE_MODEL=gemma4:e4b

# Browser Automation & Playwright Configuration
BROWSER_USER_DATA_DIR=./browser_user_data
BROWSER_HEADLESS=false

# Temporal Configuration
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=agent-queue

# Sentry Configuration
SENTRY_DSN=https://your-sentry-dsn-here@o0.ingest.sentry.io/0

# User Credentials for Wellfound Website
USER_EMAIL=your_username
USER_PASSWORD=your_password
